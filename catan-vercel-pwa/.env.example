# Multijugador online (Supabase) — opcional.
# Sin estas variables la app funciona en modo local/offline.
#
# 1. Crear proyecto en https://supabase.com (plan gratuito alcanza)
# 2. SQL Editor → pegar y correr supabase/schema.sql
# 3. Authentication → Sign In / Up → habilitar "Anonymous sign-ins"
# 4. Settings → API → copiar URL y anon key acá (y en Vercel → Environment Variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Consultor de reglas con IA (opcional) — se usa SOLO en el server (api/rules.js).
# Sin esta variable el botón "❓ Reglas" explica cómo activarlo y no consume nada.
# Crear una key en https://console.anthropic.com → Vercel → Environment Variables
# (marcala como "Sensitive": nunca llega al navegador).
ANTHROPIC_API_KEY=
# Opcional: cambiar el modelo (por defecto claude-opus-5).
# CATAN_RULES_MODEL=

# ── Diagnóstico y analytics (opcionales) ──
#
# Los errores SIEMPRE se guardan en el propio dispositivo (últimos 10) y se
# pueden copiar desde la app: la tarjeta "⚠️ errores registrados" aparece en la
# pantalla de inicio solo si hubo alguno. Eso no necesita configurar nada y no
# manda nada a ninguna parte.
#
# Si además querés recibirlos, poné un endpoint que acepte POST con JSON.
# Sin estas variables no se hace ninguna request y no entra ningún tercero.
VITE_ERROR_ENDPOINT=
# Eventos de producto (partida_iniciada / partida_terminada): cuántos jugadores,
# qué modo, si fue online. No lleva id de usuario, cookies ni nombres.
VITE_ANALYTICS_ENDPOINT=
# Versión que acompaña cada reporte, para saber de qué deploy vino.
# En Vercel conviene: VITE_APP_VERSION=$VERCEL_GIT_COMMIT_SHA
VITE_APP_VERSION=

# ── URL del sitio (opcional) ──
# Solo para la imagen de Open Graph (cómo se ve el link al compartirlo).
# Si no se setea, el build usa el dominio que expone Vercel.
# SITE_URL=https://tu-dominio.com
